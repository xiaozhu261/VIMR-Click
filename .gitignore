# Ephemeral experiment artifacts. Keep reproducible scripts and final metrics,
# but do not commit smoke/preflight/benchmark runs, logs, or generated weights.
/outputs/_smoke*
/outputs/_benchmark*
/outputs/_preflight*
/outputs/*quick*
/outputs/**/*.log
/outputs/**/*.pt
/outputs/**/split_manifest.json
/outputs/**/per_instance.csv

# Generated training data and local run state stay on the training machine.
# Keep experiment reports, metrics, manifests, and report figures in Git.
/outputs/**/masks/
/outputs/**/*.npy
/outputs/**/modeling_clicks*.jsonl
/outputs/**/difficulty_targets*.jsonl
/outputs/**/raw_export/
